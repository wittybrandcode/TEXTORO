  "shapeExpressions": {
    "fillOpacity": "box/hideWhenEmpty with Fill Opacity",
    "strokeOpacity": "box/hideWhenEmpty with Stroke Opacity",
    "fillColor": "parent.effect(\"Fill Color\")(\"Color\")",
    "strokeColor": "parent.effect(\"Stroke Color\")(\"Color\")",
    "strokeWidth": "Math.max(0, parent.effect(\"Stroke Width\")(\"Slider\"))",
    "trimStart": "parent.effect(\"Trim Start\")(\"Slider\")",
    "trimEnd": "parent.effect(\"Trim End\")(\"Slider\")",
    "trimOffset": "parent.effect(\"Trim Offset\")(\"Slider\") * 360 / 100",
    "pathOffset": "parent.effect(\"Path Offset\")(\"Slider\")",
    "dashLength": "parent.effect(\"Stroke Dash\")(\"Slider\")",
    "gapLength": "var g = parent.effect(\"Stroke Gap\")(\"Slider\"); g > 0 ? g : parent.effect(\"Stroke Dash\")(\"Slider\")"
  },

  "animators": {
